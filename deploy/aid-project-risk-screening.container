[Unit]
Description=Aid Project Risk Screening web app
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/sgesang/aid-project-risk-screening:main
ContainerName=aid-project-risk-screening
PublishPort=192.168.68.194:4175:8000
Environment=MODEL_MODE=demo
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
Tmpfs=/tmp:rw,noexec,nosuid,size=64m
AutoUpdate=registry
Notify=healthy
HealthCmd=python /app/backend/healthcheck.py
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=30s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
MemoryMax=1G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
