[Unit]
Description=Aid Project Risk Screening
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/YOUR_NAMESPACE/aid-project-risk-screening@sha256:YOUR_VERIFIED_DIGEST
ContainerName=aid-screening
PublishPort=127.0.0.1:8000:8000
Environment=MODEL_MODE=demo
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
Tmpfs=/tmp:rw,noexec,nosuid,size=64m
HealthCmd=python -c "from urllib.request import urlopen; urlopen('http://127.0.0.1:8000/api/health', timeout=2)"
HealthInterval=30s
HealthTimeout=3s
HealthRetries=3
HealthOnFailure=kill

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
MemoryMax=1G
CPUQuota=200%

[Install]
WantedBy=default.target
